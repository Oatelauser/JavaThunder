<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.oatelauser</groupId>
    <artifactId>javathunder</artifactId>
    <version>1.1.0</version>
  </parent>

  <artifactId>javathunder-api</artifactId>
  <name>JavaThunder :: API</name>
  <description>Public API: client facade, download tasks, events, configuration. No implementation types.</description>

  <dependencies>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
        <!-- 公共 API 守门员：任何破坏性 API 变更令构建失败（基线始终对上一个发布 tag） -->
      <plugin>
        <groupId>com.github.siom79.japicmp</groupId>
        <artifactId>japicmp-maven-plugin</artifactId>
        <version>0.23.1</version>
        <configuration>
          <!-- oldVersion 用 file 指向本地仓库基线 jar 而非 dependency 坐标：基线版本与
               当前项目版本相同时，dependency 会被 reactor 解析成本模块刚构建的 jar，
               old==new 恒零差异，护栏失效（file 方式始终取仓库里安装的基线；
               见 tracker/tools pom 同注）。基线始终对上一个发布 tag（CI/本地自举安装）。 -->
          <oldVersion>
            <file>
              <path>${settings.localRepository}/io/github/oatelauser/javathunder-api/1.1.0/javathunder-api-1.1.0.jar</path>
            </file>
          </oldVersion>
          <newVersion>
            <file>
              <path>${project.build.directory}/${project.build.finalName}.jar</path>
            </file>
          </newVersion>
          <parameter>
            <onlyModified>true</onlyModified>
            <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
            <includes>
              <include>io.github.oatelauser.thunder.api</include>
            </includes>
          </parameter>
          <skip>${skipJapicmp}</skip>
        </configuration>
        <executions>
          <execution>
            <phase>verify</phase>
            <goals>
              <goal>cmp</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- 附加 *-with-dependencies.jar：配置继承根 pom -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

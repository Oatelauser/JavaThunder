<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  JavaThunder 代码规范门禁（verify 阶段执行）：
  1. 禁止内联全路径类名（如 x1.x2.x3.User），必须 import 后使用简单类名；注释与 package/import 行除外。
  2. 禁止通配 import（import a.b.*）。
  3. 禁止未用 import。
  4. 方法长度硬上限 50 行。
  例外：确需全路径（简单类名冲突、反射字面量等）或测试编排方法超长，登记到同目录
  suppressions.xml 并写明理由与清理期限。
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>

  <module name="SuppressionFilter">
    <property name="file" value="${checkstyle.suppressions.file}"/>
    <property name="optional" value="true"/>
  </module>

  <module name="TreeWalker">
    <!-- 内联全路径类名禁止（package/import 行与注释除外） -->
    <module name="RegexpSinglelineJava">
      <property name="format" value="^(?!\s*(package|import)\s).*\b(?:[a-z][a-zA-Z0-9_]*\.){2,}[A-Z][A-Za-z0-9_]*"/>
      <property name="ignoreComments" value="true"/>
      <property name="message" value="禁止内联全路径类名：请 import 后使用简单类名；确有冲突请登记 config/checkstyle/suppressions.xml"/>
    </module>

    <module name="AvoidStarImport"/>
    <module name="UnusedImports"/>
    <module name="MethodLength">
      <property name="max" value="50"/>
    </module>
    <!-- 就地豁免（尽量不用，改走 suppressions.xml 登记制） -->
    <module name="SuppressionCommentFilter">
      <property name="offCommentFormat" value="CHECKSTYLE\.OFF (\w+)"/>
      <property name="onCommentFormat" value="CHECKSTYLE\.ON (\w+)"/>
      <property name="checkFormat" value="$1"/>
    </module>
  </module>
</module>

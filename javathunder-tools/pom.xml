<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.oatelauser</groupId>
    <artifactId>javathunder</artifactId>
    <version>0.5.0</version>
  </parent>

  <artifactId>javathunder-tools</artifactId>
  <name>JavaThunder :: Tools</name>
  <description>Integration-test toolkit for library users: torrent generator, fake peers, transport switch. Embedded tracker now lives in javathunder-tracker.</description>

  <dependencies>
    <dependency>
      <groupId>io.github.oatelauser</groupId>
      <artifactId>javathunder-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.oatelauser</groupId>
      <artifactId>javathunder-tracker</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- 互操作裁判（test 作用域，非运行时依赖）：第三方 BT 实现，验证协议兼容性 -->
    <dependency>
      <groupId>com.turn</groupId>
      <artifactId>ttorrent-core</artifactId>
      <version>1.5</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <properties>
    <surefire.excludedGroups>perf,interop</surefire.excludedGroups>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludedGroups>${surefire.excludedGroups}</excludedGroups>
          <systemPropertyVariables>
            <org.slf4j.simpleLogger.defaultLogLevel>debug</org.slf4j.simpleLogger.defaultLogLevel>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <!-- 公共 API 守门员（宽松版）：仅拦二进制不兼容变更。testkit 是测试工具，
           消费方是与库同步重编译的用户测试代码，源码级不兼容可接受；
           但已编译测试字节码的可链接性必须保证，故 binary 门槛不可省。
           包名沿用历史 io.github.oatelauser.thunder.testkit（原 testkit 模块坐标）。
           tools 首发于 v0.3.0；基线随每版发布上移（当前 v0.4.0）。
           oldVersion 用 file 指向本地仓库基线 jar：dependency 方式在同版本下
           会被 reactor 解析成本模块自身，护栏失效（见 tracker pom 同注）。 -->
      <plugin>
        <groupId>com.github.siom79.japicmp</groupId>
        <artifactId>japicmp-maven-plugin</artifactId>
        <version>0.23.1</version>
        <configuration>
          <oldVersion>
            <file>
              <path>${settings.localRepository}/io/github/oatelauser/javathunder-tools/0.4.0/javathunder-tools-0.4.0.jar</path>
            </file>
          </oldVersion>
          <oldClassPathDependencies>
            <dependency>
              <groupId>io.github.oatelauser</groupId>
              <artifactId>javathunder-core</artifactId>
              <version>0.4.0</version>
            </dependency>
            <dependency>
              <groupId>io.github.oatelauser</groupId>
              <artifactId>javathunder-tracker</artifactId>
              <version>0.4.0</version>
            </dependency>
          </oldClassPathDependencies>
          <!-- 显式 old/new 类路径成对出现：只配 old 会让 new 侧类路径为空，
               testkit 触达 core internal 类型时分析直接崩（ClassNotFound）。
               old 侧钉基线版本（0.3.0），new 侧随当前版本。 -->
          <newClassPathDependencies>
            <dependency>
              <groupId>io.github.oatelauser</groupId>
              <artifactId>javathunder-core</artifactId>
              <version>${project.version}</version>
            </dependency>
            <dependency>
              <groupId>io.github.oatelauser</groupId>
              <artifactId>javathunder-tracker</artifactId>
              <version>${project.version}</version>
            </dependency>
          </newClassPathDependencies>
          <newVersion>
            <file>
              <path>${project.build.directory}/${project.build.finalName}.jar</path>
            </file>
          </newVersion>
          <parameter>
            <onlyModified>true</onlyModified>
            <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
            <!-- 宽松点：testkit 刻意触达 core 的 internal 类型，core 内部类重构
                 不应让本护栏崩掉；判定仍只看 testkit 包自身的二进制兼容。 -->
            <ignoreMissingClasses>true</ignoreMissingClasses>
            <includes>
              <include>io.github.oatelauser.thunder.testkit</include>
            </includes>
          </parameter>
          <skip>${skipJapicmp}</skip>
        </configuration>
        <executions>
          <execution>
            <phase>verify</phase>
            <goals>
              <goal>cmp</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- 附加 *-with-dependencies.jar：配置继承根 pom（test 作用域的 junit/ttorrent 不打入） -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
